// Nextflow settings for pgsc_calc child jobs on Slurm. Edit for your site.
process {
    executor       = 'slurm'
    queue          = System.getenv('SLURM_PARTITION') ?: 'general'
    clusterOptions = System.getenv('SLURM_ACCOUNT') ? "--account=${System.getenv('SLURM_ACCOUNT')}" : ''
    // pgsc_calc's own resource labels; raise these for large datasets.
    withLabel: process_low    { cpus = 2;  memory = 8.GB;  time = 4.h  }
    withLabel: process_medium { cpus = 6;  memory = 36.GB; time = 12.h }
    withLabel: process_high   { cpus = 12; memory = 72.GB; time = 24.h }
}
executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}
singularity {
    enabled    = true
    autoMounts = true
    // Scoring files are symlinks into the Catalog snapshot; bind the whole data root.
    runOptions = "-B ${System.getenv('ATLAS_ROOT')}"
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('ATLAS_ROOT')}/singularity"
}
