# One file per dataset. The slug must have no spaces, dots or underscores
# (pgsc_calc's sampleset rule).
DATASET=1kg-30x
TARGET_BUILD=GRCh38

# Genotypes. {chrom} is replaced with 1..22.
# FORMAT=vcf reads VCFs directly; FORMAT=pfile uses a one-time plink2 conversion
# (bin/vcf-to-pfile.sbatch), which is much faster when there are many batches.
FORMAT=vcf
VCF_PATTERN=/path/to/1kg-30x/1kGP_high_coverage_Illumina.chr{chrom}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz
VCF_FIELD=GT                       # GT for WGS hard calls, DS for imputed dosages
PFILE_PATTERN=/path/to/1kg-30x/pfile/chr{chrom}
CHROMS="$(seq -s ' ' 1 22)"
