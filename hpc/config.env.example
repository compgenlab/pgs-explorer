# Site settings for running pgsc_calc by hand on the cluster.
# Copy to config.env and edit. Sourced by every script in bin/.

# pgsc_calc release. v2.x is required for --run_ancestry (v3 alphas lack it).
PGSC_CALC_VERSION=v2.3.0
NXF_PROFILE=singularity            # singularity | apptainer | conda
NXF_CONFIG="$HPC_DIR/nextflow/slurm.config"

# Ancestry reference panel, downloaded once (no network needed on compute nodes).
REF_PANEL=/path/to/pgsc_HGDP+1kGP_v1.tar.zst

# Where things live on the cluster filesystem.
ATLAS_ROOT=/path/to/pgsatlas       # catalog downloads, batches, results, work dirs
CATALOG_DIR="$ATLAS_ROOT/catalog"  # one subdirectory per Catalog snapshot date

# Batching: scores per pgsc_calc run, and how many runs per dataset at once.
BATCH_SIZE=500
MAX_PARALLEL=4

# Slurm for the per-batch Nextflow head job (Nextflow submits its own child jobs).
SLURM_PARTITION=general
SLURM_ACCOUNT=
HEAD_TIME=3-00:00:00
HEAD_MEM=8G

# S3 (Jetstream2 object store is S3-compatible; set the endpoint).
S3_BUCKET=s3://pgsatlas
S3_ENDPOINT=
